# ---------------------------------------------------------------------------
# spot-voice configuration.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and must never
# be committed. Nothing in this project reads a credential from anywhere else.
# ---------------------------------------------------------------------------

# --- Mode -------------------------------------------------------------------
# true  = simulate the robot; run the whole experience at a desk with just a mic
# false = drive a real Spot over the SDK
MOCK_ROBOT=true

# --- Robot ------------------------------------------------------------------
# Spot's address on the "Bridge Training" wifi. Both the laptop and the robot
# join that network, so if it has internet you need nothing else -- one
# interface reaches both the robot and the model API.
#
# This is a DHCP address and it moves. The robot's tablet, under MY ROBOTS, is
# the authoritative source -- it lists the robot with its current address and a
# green dot when connected. Two commands when it stops being reachable:
#     python -m spot_voice --find-robot   # sweep the subnet
#     python -m spot_voice --check        # confirm the whole path
# Worth asking for a DHCP reservation so it stops moving.
#
# Fallback: 192.168.80.3 is the same robot on its own access point (the tablet
# lists it as a second entry). That network has no internet, so the model API
# then needs a second interface -- see the README.
SPOT_IP=192.168.33.137

# Read by the Boston Dynamics SDK itself (bosdyn.client.util.authenticate).
BOSDYN_CLIENT_USERNAME=
BOSDYN_CLIENT_PASSWORD=

# Path to the GraphNav map. Point at the folder that directly contains
# `graph`, `waypoint_snapshots/` and `edge_snapshots/`.
GRAPH_PATH=C:\maps\my_facility\downloaded_graph

# Fiducial id of the charging dock. Leave blank if there is no dock.
DOCK_ID=

# --- Models -----------------------------------------------------------------
# Two independent choices: who does the tool calling, and who reads camera
# frames. Anthropic is the production target; the others are for wiring the
# system up cheaply first. Switching back is these two lines, nothing else.
#
#   LLM_PROVIDER=groq       + VISION_PROVIDER=gemini      <- testing
#   LLM_PROVIDER=anthropic  + VISION_PROVIDER=anthropic   <- production
#
LLM_PROVIDER=groq

# Leave blank to pick automatically: 'anthropic' when the LLM can see images
# itself, otherwise 'gemini' if a Gemini key is set, otherwise 'none'.
VISION_PROVIDER=

# -- Anthropic (production) --
# claude-sonnet-4-6 is the configured default: fast enough for conversation and
# strong at tool use. claude-sonnet-5 and claude-opus-5 are the current
# generation and are drop-in replacements if you want more capability.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# -- Groq (testing: tool calling) --
# Text-only, so camera frames go through the vision provider instead. Check
# console.groq.com for the current tool-calling model if this id is stale.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -- Gemini (testing: images) --
# Check ai.google.dev for the current model id if this one is stale.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Microphone -------------------------------------------------------------
# Case-insensitive substring of the input device name. The Hollyland Lark M1
# receiver usually appears as "USB Audio Device". Run
#     python -m spot_voice --list-devices
# to see the exact names. Leave blank for the system default.
MIC_DEVICE_NAME=USB Audio

# faster-whisper model size: tiny | base | small. `base` is real time on a
# laptop CPU; `small` is more accurate on accented speech.
WHISPER_MODEL=base
STT_LANGUAGE=en

# --- Speech output ----------------------------------------------------------
# edge    = Microsoft Edge neural voices. Good quality, but the text of every
#           reply is sent to Microsoft's servers.
# offline = local Windows SAPI5 voice. Nothing leaves the machine.
TTS_ENGINE=edge
TTS_VOICE=en-US-GuyNeural

# robot  = play through Spot CAM's speaker (needs MOCK_ROBOT=false)
# laptop = play through the laptop
AUDIO_OUT=laptop

# Gate the microphone while Spot is speaking so it does not transcribe its own
# voice. Set to false only if the mic is far enough from the speaker.
MUTE_WHILE_SPEAKING=true

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
